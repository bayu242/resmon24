{
  "name": "@resmon24/protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "resmon24 shared communication protocol: JSON Schemas (source of truth) and generated TypeScript/C++ types.",
  "types": "./generated/typescript/index.ts",
