    "generate": "node ../../scripts/generate-protocol.mjs",
    "check": "node ../../scripts/generate-protocol.mjs --check",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "~5.8.3"
  }
}
