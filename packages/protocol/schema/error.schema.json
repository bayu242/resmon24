{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resmon24.dev/protocol/error.schema.json",
  "title": "error",
  "description": "Either direction. Reports a protocol or payload error.",
  "type": "object",
  "allOf": [
    { "$ref": "envelope.schema.json#/$defs/Envelope" },
    {
      "type": "object",
      "required": ["type", "data"],
      "properties": {
        "type": { "const": "error" },
        "data": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": {
              "enum": [
                "INVALID_PAYLOAD",
                "UNSUPPORTED_TYPE",
                "PAYLOAD_TOO_LARGE",
                "UNSUPPORTED_VERSION",
                "INTERNAL"
              ],
              "description": "Machine-readable error code."
            },
            "message": { "type": "string", "description": "Human-readable error detail." }
          }
        }
      }
    }
  ]
}
